# Required
DOMAIN=gitea.kostelidis.dev
POSTGRES_PASSWORD=password

# SSH for git clone/push. Must not clash with the host's own sshd (usually 22).
# Clone URLs will use this port: ssh://git@git.example.com:2222/owner/repo.git
GITEA_SSH_PORT=2222
# Bind to a specific interface (e.g. a VPN IP) to keep SSH off the public internet
GITEA_SSH_BIND=0.0.0.0

# Packages storage on a network share (examples):
#   NFS:  type=nfs   o=addr=192.168.1.10,nfsvers=4.1,hard   device=:/export/gitea-packages
#   CIFS: type=cifs  o=addr=192.168.1.10,username=u,password=p,uid=1000,gid=1000  device=//192.168.1.10/gitea-packages
PACKAGES_MOUNT_TYPE=cifs
PACKAGES_MOUNT_O=addr=192.168.1.10,username=u,password=p,vers=3.1.1,iocharset=utf8,seal,uid=1000,gid=1000,file_mode=0664,dir_mode=0775
PACKAGES_MOUNT_DEVICE=//192.168.1.10/gitea-packages

# Access control for the web UI, API and package registry (not SSH).
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# Network address ranges (dual-stack). Must not overlap other Docker networks or the LAN.
# GITEA_NETWORK_* is the network shared with Traefik; DATABASE_NETWORK_* is the internal Gitea <-> Postgres network.
GITEA_NETWORK_SUBNET_V4=10.100.0.0/24
GITEA_NETWORK_SUBNET_V6=fd00:100::/64
DATABASE_NETWORK_SUBNET_V4=10.100.1.0/24
DATABASE_NETWORK_SUBNET_V6=fd00:100:1::/64

# Image versions — pin exact releases
GITEA_TAG=28.0.0
POSTGRES_TAG=18.6-alpine

# Database identity. These must match the existing database —
# changing them on an initialised volume does NOT rename the DB or user.
POSTGRES_DB=db
POSTGRES_USER=user

# Optional overrides
TZ=Europe/Athens
GITEA_CPU_LIMIT=2
GITEA_MEM_LIMIT=1G
GITEA_MEM_RESERVATION=256M
GITEA_PIDS_LIMIT=1024
DATABASE_CPU_LIMIT=1
DATABASE_MEM_LIMIT=512M
DATABASE_MEM_RESERVATION=256M
DATABASE_PIDS_LIMIT=256
